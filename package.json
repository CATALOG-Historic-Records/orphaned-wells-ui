{
  "name": "uow_frontend",
  "version": "0.1.0",
  "private": true,
  "dependencies": {
    "@emotion/react": "^11.11.1",
    "@emotion/styled": "^11.11.0",
    "@mui/icons-material": "^5.14.19",
    "@mui/material": "^5.14.19",
    "@react-oauth/google": "^0.12.1",
    "@testing-library/jest-dom": "^5.17.0",
    "@testing-library/react": "^13.4.0",
    "@testing-library/user-event": "^13.5.0",
    "@types/react": "^18.2.39",
    "@types/react-dom": "^18.2.17",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-drag-drop-files": "^2.3.10",
    "react-draggable": "^4.4.6",
    "react-image-crop": "^11.0.5",
    "react-lasso-select": "^1.2.2",
    "react-loader-spinner": "^6.1.6",
    "react-router-dom": "^6.30.4",
    "typescript": "~5.6.2",
    "web-vitals": "^2.1.4"
  },
  "devDependencies": {
    "@testing-library/cypress": "^10.0.2",
    "@types/jest": "^29.5.12",
    "@types/mocha": "^10.0.7",
    "@types/node": "^22.5.5",
    "@vitejs/plugin-react": "^4.7.0",
    "cypress": "^13.14.2",
    "dotenv": "^16.4.7",
    "fflate": "0.8.3",
    "jsdom": "^26.1.0",
    "vite": "^6.4.6",
    "vitest": "^4.1.12"
  },
  "overrides": {
    "@cypress/request": {
      "qs": "^6.16.1",
      "uuid": "^11.1.1"
    }
  },
  "scripts": {
    "start": "vite",
    "docker:start": "node deployment/scripts/docker-dev-stack.cjs start",
    "docker:stop": "node deployment/scripts/docker-dev-stack.cjs stop",
    "docker:down": "node deployment/scripts/docker-dev-stack.cjs down",
    "docker:clean": "node deployment/scripts/docker-dev-stack.cjs clean",
    "docker:e2e": "node deployment/scripts/docker-e2e-stack.cjs start",
    "docker:e2e:stop": "node deployment/scripts/docker-e2e-stack.cjs stop",
    "docker:e2e:down": "node deployment/scripts/docker-e2e-stack.cjs down",
    "docker:e2e:clean": "node deployment/scripts/docker-e2e-stack.cjs clean",
    "docker:e2e:seed": "node deployment/scripts/docker-e2e-stack.cjs seed",
    "docker:e2e:recreate-backend": "node deployment/scripts/docker-e2e-stack.cjs recreate-backend",
    "docker:start:shell": "sh deployment/scripts/start-dev-stack.sh",
    "docker:stop:shell": "sh deployment/scripts/stop-dev-stack.sh",
    "docker:down:shell": "sh deployment/scripts/down-dev-stack.sh",
    "docker:clean:shell": "sh deployment/scripts/clean-dev-stack.sh",
    "docs:start": "npm --prefix docs run start",
    "build": "vite build",
    "test": "node -e \"const {spawnSync}=require('child_process');const args=process.argv.slice(1).filter(a=>!a.startsWith('--watchAll')&&a!=='--runInBand');process.exit(spawnSync('./node_modules/.bin/vitest',['run',...args],{stdio:'inherit'}).status??1)\" --",
    "e2e:open": "node deployment/scripts/run-cypress-e2e.cjs open",
    "e2e:run": "node deployment/scripts/run-cypress-e2e.cjs run",
    "e2e:smoke": "node deployment/scripts/run-cypress-e2e.cjs smoke",
    "e2e:schema-modes": "node deployment/scripts/run-cypress-e2e.cjs schema-modes",
    "e2e:full": "node deployment/scripts/run-cypress-e2e.cjs full",
    "e2e:ci": "node deployment/scripts/run-cypress-e2e.cjs ci",
    "lint": "eslint . --fix",
    "gcp-build": ""
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  }
}
